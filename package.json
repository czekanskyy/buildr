{
  "name": "buildr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@buildr/playground",
    "dev:example": "turbo run dev --filter=@buildr/example-next-payload",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs packages apps tooling/smoke",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "lefthook install",
    "e2e": "turbo run e2e",
    "gen:component": "node scripts/gen-component.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "^2.29.7",
    "dependency-cruiser": "^18.4.0",
    "lefthook": "2.1.14",
    "turbo": "2.11.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
