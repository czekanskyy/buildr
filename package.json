{
  "name": "buildr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@next-buildr/playground",
    "dev:example": "turbo run dev --filter=@next-buildr/example-next-payload",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check:boundaries": "depcruise --config .dependency-cruiser.cjs packages apps tooling/smoke",
    "lint": "biome check . && pnpm lint:css",
    "lint:css": "stylelint \"packages/editor/src/**/*.css\"",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "lefthook install",
    "e2e": "turbo run e2e",
    "gen:component": "node scripts/gen-component.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "^2.29.7",
    "dependency-cruiser": "^18.4.0",
    "lefthook": "2.1.14",
    "stylelint": "^17.15.0",
    "turbo": "2.11.4",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
