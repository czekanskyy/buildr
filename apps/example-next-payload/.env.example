DATABASE_URL=
PAYLOAD_SECRET=change-me

# Optional public Maps Embed API key; restrict it by HTTP referrer and to Maps Embed API.
GOOGLE_MAPS_EMBED_API_KEY=
# Setting the map key or a valid Turnstile site key adds a frame-src restriction to public routes.
# Add any other iframe hosts to next.config.ts.

# Optional public Turnstile site key (1–128 letters, digits, underscores or hyphens).
# Published dummy test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SITE_KEY=
# Server only: read exclusively by payload.config.ts; never use NEXT_PUBLIC_* or next.config env.
TURNSTILE_SECRET_KEY=
# Required with both keys: comma-separated exact hostnames, without scheme, path or port.
CAPTCHA_HOSTNAMES=
# Required with captcha: trusted proxy header, e.g. cf-connecting-ip (rightmost address, hops: 1).
# The proxy must overwrite this header and the origin must not be reachable directly.
CLIENT_IP_HEADER=
