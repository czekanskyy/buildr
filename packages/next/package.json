{
  "name": "@buildr/next",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./draft": {
      "types": "./src/draft/index.ts",
      "default": "./src/draft/index.ts"
    },
    "./canvas": {
      "types": "./src/canvas/index.ts",
      "default": "./src/canvas/index.ts"
    },
    "./editor": {
      "types": "./src/editor/index.ts",
      "default": "./src/editor/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./draft": {
        "types": "./dist/draft/index.d.ts",
        "default": "./dist/draft/index.js"
      },
      "./canvas": {
        "types": "./dist/canvas/index.d.ts",
        "default": "./dist/canvas/index.js"
      },
      "./editor": {
        "types": "./dist/editor/index.d.ts",
        "default": "./dist/editor/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@buildr/core": "workspace:*",
    "@buildr/react": "workspace:*"
  },
  "peerDependencies": {
    "@buildr/editor": "workspace:*",
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@buildr/editor": {
      "optional": true
    }
  },
  "devDependencies": {
    "next": "16.3.5",
    "@buildr/editor": "workspace:*",
    "@buildr/tsconfig": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
