{
  "name": "@buildr/payload",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./plugin": {
      "types": "./src/plugin/index.ts",
      "default": "./src/plugin/index.ts"
    },
    "./data": {
      "types": "./src/data/index.ts",
      "default": "./src/data/index.ts"
    },
    "./admin": {
      "types": "./src/admin/index.ts",
      "default": "./src/admin/index.ts"
    },
    "./adapter": {
      "types": "./src/adapter/index.ts",
      "default": "./src/adapter/index.ts"
    },
    "./next": {
      "types": "./src/next/index.ts",
      "default": "./src/next/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./plugin": {
        "types": "./dist/plugin/index.d.ts",
        "default": "./dist/plugin/index.js"
      },
      "./data": {
        "types": "./dist/data/index.d.ts",
        "default": "./dist/data/index.js"
      },
      "./admin": {
        "types": "./dist/admin/index.d.ts",
        "default": "./dist/admin/index.js"
      },
      "./adapter": {
        "types": "./dist/adapter/index.d.ts",
        "default": "./dist/adapter/index.js"
      },
      "./next": {
        "types": "./dist/next/index.d.ts",
        "default": "./dist/next/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@buildr/core": "workspace:*",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@buildr/next": "workspace:*",
    "next": "^15.0.0 || ^16.0.0",
    "payload": "^3.0.0",
    "@payloadcms/ui": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@buildr/next": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "payload": {
      "optional": true
    },
    "@payloadcms/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@buildr/next": "workspace:*",
    "@buildr/tsconfig": "workspace:*",
    "@payloadcms/db-sqlite": "3.90.1",
    "@payloadcms/ui": "3.90.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
