  }
}</style><div class="bc-page"><div class="bc-gallery"><div class="bc-gallery__list" role="list" data-columns="3" data-ratio="1:1"><div class="bc-loop"><div class="bc-gallery-item" role="listitem"><figure><a class="bc-gallery-item__link" href="/media/gallery.svg" aria-label="Bound landscape"><img src="/media/gallery.svg" alt="Bound landscape" loading="lazy" decoding="async" sizes="100vw"></a><figcaption>Bound caption</figcaption></figure></div><div class="bc-loop__after"></div></div></div><span hidden="" data-gallery-enhancer=""></span></div></div>