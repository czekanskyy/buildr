<style data-precedence="buildr" data-href="buildr-theme-tk3w4rawdgzv">@layer buildr.reset, buildr.tokens, buildr.components, buildr.nodes;
@layer buildr.tokens {
  :root {
    --b-color-border: #d1d5db;
    --b-color-danger: #b91c1c;
    --b-color-focus: #1d4ed8;
