    --b-color-text: #111827;
    --b-color-text-muted: #4b5563;
    --b-space-0: 0;
    --b-space-1: 0.25rem;
    --b-space-12: 3rem;
    --b-space-16: 4rem;
    --b-space-2: 0.5rem;
    --b-space-24: 6rem;
    --b-space-3: 0.75rem;
    --b-space-4: 1rem;
    --b-space-6: 1.5rem;
    --b-space-8: 2rem;
    --b-radius-full: 9999px;
    --b-radius-lg: 1rem;
    --b-radius-md: 0.5rem;
