{
  "name": "@buildr/test-utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@buildr/core": "workspace:*"
  },
  "devDependencies": {
    "@buildr/tsconfig": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
