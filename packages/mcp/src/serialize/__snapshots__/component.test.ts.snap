exports[`describeComponent over every built-in component > buildr/video: text description 1`] = `
"buildr/video - Video (media, v1)
A video with an accessible name, optional poster and captions.
Props:
- video (media) default null accepts video [bindable]
- poster (media) default null accepts image [bindable]
- title (text) default "" [bindable, localizable]
- captions (media) default null accepts text [bindable]
- captionsLanguage (text) default "" [bindable, localizable]
- captionsLabel (text) default "" [bindable, localizable]
- controls (boolean) default true [bindable]
- loop (boolean) default false [bindable]
- autoplay (boolean) default false [bindable]
- muted (boolean) default false [bindable]
- preload (select) default "metadata" one of "none" | "metadata"
- aspectRatio (select) default "16:9" one of "16:9" | "4:3" | "1:1" | "9:16" | "21:9" | "auto"
- fit (select) default "contain" one of "contain" | "cover"
Slots: none (a leaf component, it takes no children)
Note: It needs an accessible name (text, label or aria-label).
Style groups: size, spacing, border, effects, motion, visibility
Renders: video
Insert into: buildr/page[default]
Example: {"type":"buildr/video"}"
`;
