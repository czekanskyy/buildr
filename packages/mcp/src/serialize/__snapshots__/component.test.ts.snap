exports[`describeComponent over every built-in component > buildr/card: text description 1`] = `
"buildr/card - Card (ui, v1)
A boxed piece of content with media, text and actions.
Props:
- href (link) default "" [bindable, localizable]
- linkLabel (text) default "" [bindable, localizable]
- newTab (boolean) default false [bindable]
- variant (select) default "outlined" one of "outlined" | "elevated" | "flat"
- as (select) default "article" one of "article" | "div"
Slots:
- media (max 1): buildr/image, buildr/video, buildr/iframe, buildr/icon
- body: buildr/container, buildr/grid, buildr/spacer, buildr/anchor, buildr/heading, buildr/text, buildr/rich-text, buildr/button, buildr/link, buildr/image, buildr/video, buildr/iframe, buildr/carousel, buildr/gallery, buildr/icon, buildr/list, buildr/divider, buildr/badge, buildr/card, buildr/accordion, buildr/loop, buildr/pagination, buildr/form, buildr/fieldset, buildr/input, buildr/textarea, buildr/select, buildr/checkbox
- actions: buildr/button, buildr/link, buildr/iframe
Style groups: layout, size, spacing, background, border, effects, motion, visibility
Renders: article
Insert into: buildr/page[default]
Example: {"type":"buildr/card"}"
`;

