exports[`describeComponent over every built-in component > buildr/container: text description 1`] = `
"buildr/container - Container (layout, v3)
A box for content: a column, row or grid, optionally width-limited, a landmark, or with a background image or video.
Props:
- display (select) default "flex" one of "flex" | "block" | "grid" | "inline-flex" | "inline-block"
- as (select) default "div" one of "div" | "section" | "header" | "footer" | "main" | "aside" | "nav" | "article"
- width (select) default "lg" one of "none" | "sm" | "md" | "lg" | "xl"
- bleed (boolean) default false [bindable]
- backgroundImage (media) default null accepts image [bindable]
- backgroundVideo (media) default null accepts video [bindable]
- backgroundPoster (media) default null accepts image [bindable]
- backgroundOverlay (media) default null accepts image [bindable]
- overlayTone (select) default "none" one of "none" | "dark" | "light"
- overlayOpacity (number) default 0.5 min 0; max 1 [bindable]
- backgroundFit (select) default "cover" one of "cover" | "contain"
- backgroundPosition (select) default "center" one of "center" | "top" | "bottom" | "left" | "right" | "top-left" | "top-right" | "bottom-left" | "bottom-right"
- backgroundAttachment (select) default "scroll" one of "scroll" | "fixed"
- role (select) default "none" one of "none" | "group" | "list"
- ariaLabel (text) default "" [bindable, localizable]
Slots:
- default: buildr/container, buildr/grid, buildr/spacer, buildr/anchor, buildr/heading, buildr/text, buildr/rich-text, buildr/button, buildr/link, buildr/image, buildr/video, buildr/iframe, buildr/carousel, buildr/gallery, buildr/icon, buildr/list, buildr/divider, buildr/badge, buildr/card, buildr/accordion, buildr/loop, buildr/pagination, buildr/form, buildr/fieldset, buildr/input, buildr/textarea, buildr/select, buildr/checkbox
Style groups: layout, size, spacing, typography, background, border, effects, motion, visibility
Renders: div
Insert into: buildr/page[default]
Example: {"type":"buildr/container"}"
`;

