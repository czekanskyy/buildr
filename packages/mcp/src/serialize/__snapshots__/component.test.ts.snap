exports[`describeComponent over every built-in component > buildr/carousel: text description 1`] = `
"buildr/carousel - Carousel (media, v1)
Scrollable slides with optional rotation.
Props:
- ariaLabel (text) default "" [bindable, localizable]
- showArrows (boolean) default true [bindable]
- showDots (boolean) default true [bindable]
- loop (boolean) default false [bindable]
- autoplay (boolean) default false [bindable]
- interval (number) default 5000 min 3000; max 20000 [bindable]
- slidesPerView (number) default 1 min 1; max 4 [bindable]
Slots:
- default: buildr/carousel-slide, buildr/loop
Style groups: size, spacing, background, border, effects, visibility
Renders: section
Insert into: buildr/page[default]
Example: {"type":"buildr/carousel","slots":{"default":[{"type":"buildr/carousel-slide"},{"type":"buildr/carousel-slide"},{"type":"buildr/carousel-slide"}]}}"
`;

