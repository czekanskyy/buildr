{
  "name": "@buildr/core",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./commands": {
      "types": "./src/commands/index.ts",
      "default": "./src/commands/index.ts"
    },
    "./protocol": {
      "types": "./src/protocol/index.ts",
      "default": "./src/protocol/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./commands": {
        "types": "./dist/commands/index.d.ts",
        "default": "./dist/commands/index.js"
      },
      "./protocol": {
        "types": "./dist/protocol/index.d.ts",
        "default": "./dist/protocol/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@buildr/tsconfig": "workspace:*",
    "@types/css-tree": "^3.2.0",
    "css-tree": "^3.2.1",
    "fast-check": "^4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
